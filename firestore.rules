rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection test doc (used to check Firestore connectivity)
    match /test/connection {
      allow read: if true;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) && isValidId(transactionId);
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId) && isValidId(categoryId);
      }

      // Settings subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId) && isValidId(settingId);
      }
    }
  }
}
